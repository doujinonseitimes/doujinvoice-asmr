}

@keyframes auroraMove{

  0%{
    transform:
      translateY(0px)
      scale(1);
  }

  50%{
    transform:
      translateY(-30px)
      scale(1.1);
  }

  100%{
    transform:
      translateY(0px)
      scale(1);
  }

}

/* リング */

.ring{

  position:fixed;

  border-radius:50%;

  border:
    1px solid rgba(255,255,255,0.35);

  backdrop-filter:blur(2px);

  z-index:-8;

  animation:
    ringRotate linear infinite;
}

.ring1{

  width:540px;
  height:540px;

  top:12%;
  left:-180px;

  animation-duration:24s;
}

.ring2{

  width:340px;
  height:340px;

  bottom:10%;
  right:-100px;

  animation-duration:18s;
}

@keyframes ringRotate{

  0%{
    transform:
      rotate(0deg)
      translateY(0px);
  }

  50%{
    transform:
      rotate(180deg)
      translateY(-18px);
  }

  100%{
    transform:
      rotate(360deg)
      translateY(0px);
  }

}

/* 雲 */

.cloud{

  position:fixed;

  background:
    rgba(255,255,255,0.74);

  border-radius:999px;

  filter:blur(7px);

  z-index:-7;

  animation:
    cloudMove ease-in-out infinite;
}

.cloud1{

  width:340px;
  height:110px;

  top:80px;
  left:-70px;

  animation-duration:9s;
}

.cloud2{

  width:480px;
  height:150px;

  top:280px;
  right:-120px;

  animation-duration:12s;
}

.cloud3{

  width:280px;
  height:95px;

  bottom:140px;
  left:8%;

  animation-duration:11s;
}

@keyframes cloudMove{

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(20px);
  }

  100%{
    transform:translateY(0px);
  }

}

/* 光粒 */

.particle{

  position:fixed;

  width:8px;
  height:8px;

  border-radius:50%;

  background:
    rgba(255,255,255,0.85);

  box-shadow:
    0 0 14px rgba(255,255,255,1);

  z-index:-6;

  animation:
    particleFloat linear infinite;
}

.p1{
  top:22%;
  left:20%;
  animation-duration:16s;
}

.p2{
  top:60%;
  left:72%;
  animation-duration:18s;
}

.p3{
  top:78%;
  left:40%;
  animation-duration:14s;
}

.p4{
  top:40%;
  left:55%;
  animation-duration:20s;
}

@keyframes particleFloat{

  0%{
    transform:
      translateY(0px)
      scale(1);

    opacity:0.2;
  }

  50%{
    transform:
      translateY(-40px)
      scale(1.5);

    opacity:1;
  }

  100%{
    transform:
      translateY(0px)
